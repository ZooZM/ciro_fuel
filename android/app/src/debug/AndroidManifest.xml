<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEBUG BUILDS ONLY. Android has blocked cleartext HTTP by default since
         API 28, so a debug build pointed at a backend on the developer's own
         machine — `http://10.0.2.2:3000` from an emulator, or the host's LAN IP
         from a handset — fails every request before it leaves the device, which
         looks like a backend outage rather than a platform policy. This file is
         merged into DEBUG builds alone; the manifest in `src/main/` is
         untouched, so a release build still refuses cleartext. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
